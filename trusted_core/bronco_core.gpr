project Bronco_Core is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnatwa",
         "-gnatVa",
         "-gnato",
         "-gnatf");
   end Compiler;
end Bronco_Core;
